# DentaFlow — variables de entorno (knowledge-base/08_arquitectura_propuesta.md §Variables de entorno)
# Copiá este archivo a .env y completá los valores. .env está ignorado por Git: NUNCA commitear secretos.
# Los valores de abajo son plantillas, no credenciales reales.

# --- Base de datos (MySQL 8 nativo) ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/dentaflow
SPRING_DATASOURCE_USERNAME=dentaflow
SPRING_DATASOURCE_PASSWORD=admin

# --- Email transaccional (se usa desde C-14; proveedor a elegir) ---
SPRING_MAIL_HOST=smtp.proveedor.example
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=usuario-smtp
SPRING_MAIL_PASSWORD=cambiar-por-clave-smtp
APP_MAIL_FROM=turnos@consultorio.example

# --- Aplicación ---
# URL pública del frontend, para armar enlaces de confirmación y cancelación
APP_BASE_URL=http://localhost:5173
# Clave de firma de sesiones o tokens (se usa desde C-04). Generar una propia, larga y aleatoria.
AUTH_SECRET=cambiar-por-una-clave-aleatoria
# Zona horaria del consultorio (solo afecta los logs: la agenda usa siempre America/Argentina/Buenos_Aires)
TZ=America/Argentina/Buenos_Aires

# --- Frontend (también en frontend/.env.example; Vite solo lee las VITE_* de frontend/) ---
VITE_API_BASE_URL=http://localhost:8080
# Carga datos de demo (3 profesionales, 2 sillones, 5 prestaciones) al arrancar si no hay recursos.
# Ya está activado en el perfil dev; en otros entornos (p. ej. la demo de C-19) poné true.
# APP_SEED_DEMO=false

# Clave de firma de los tokens de ingreso (C-04). OBLIGATORIA: mínimo 32 bytes; el backend no arranca sin ella.
# Este valor de ejemplo NO alcanza a propósito. Generá la tuya en PowerShell con:
#   $b = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
AUTH_SECRET=cambiar-por-una-clave-aleatoria
# Administrador inicial (C-04): se crea al arrancar si no hay ningún administrador activo. Datos ficticios en local.
APP_ADMIN_EMAIL=admin@consultorio.example
APP_ADMIN_PASSWORD=cambiar-por-una-contrasena-larga